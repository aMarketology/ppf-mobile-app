{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Start Metro",
			"type": "shell",
			"command": "npm start",
			"options": { "cwd": "${workspaceFolder}/PPFMobile" },
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Run Android (Debug)",
			"type": "shell",
			"command": "npm run android",
			"options": { "cwd": "${workspaceFolder}/PPFMobile" },
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Start Metro + Attach Android Device",
			"dependsOn": ["Start Metro"],
			"type": "shell",
			"command": "adb reverse tcp:8081 tcp:8081 && adb shell am start -n com.precisionprojectflow.mobile/.MainActivity",
			"isBackground": false,
			"problemMatcher": []
		}
	]
}