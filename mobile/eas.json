{
  "cli": {
    "version": ">= 7.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": false,
      "ios": {
        "buildConfiguration": "Release"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "max@amarketology.com",
        "ascAppId": "6773568727",
        "appleTeamId": "VT82GSPGZ4"
      },
      "android": {
        "serviceAccountKeyPath": "./play-store-key.json",
        "track": "internal",
        "packageName": "com.precisionprojectflow.app"
      }
    }
  }
}
